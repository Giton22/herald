<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Herald</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Lets Compose draw at 120 Hz on ProMotion screens. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Self-hosted gateways are often plain HTTP on a LAN or a tailnet, as on Android. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Herald uses the camera when you take a photo to send to your agent.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>App lock uses Face ID to open Herald.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Herald connects to the Hermes gateway you choose, which can be on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Herald records your voice when you dictate a message or talk to your agent.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Herald saves pictures from your chats to Photos when you ask it to.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>With on-device dictation, Herald turns what you say into text on your iPhone instead of on the gateway.</string>
	<!-- hermes:// links, the same ones Android opens (AppLink). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.herald.ios.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hermes</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- The fixed quick actions; the shared code adds the roster's first bots after them. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>dev.herald.ios.new-chat</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New chat</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>square.and.pencil</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>url</key>
				<string>hermes://new-chat</string>
			</dict>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>dev.herald.ios.new-chat-voice</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Dictate a message</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>mic</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>url</key>
				<string>hermes://new-chat-voice</string>
			</dict>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
