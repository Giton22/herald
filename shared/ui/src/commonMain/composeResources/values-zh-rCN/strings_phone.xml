    <string name="phone_need_dnd">请允许 Kyllene 更改勿扰模式。</string>
    <string name="phone_need_usage">请授予 Kyllene 使用情况访问权限，以查看你使用了哪些应用。</string>
    <string name="phone_need_location">请允许 Kyllene 使用这台手机的位置。</string>
    <string name="phone_need_precise">请允许精确位置：Android 只有在精确位置下才能监视地点。</string>
    <string name="phone_need_always">请始终允许位置访问：Kyllene 关闭时也会监视地点。选择“始终允许”。</string>
    <string name="phone_need_calendar">请允许 Kyllene 使用你的日历。</string>
    <string name="phone_need_contacts">请允许 Kyllene 读取你的联系人。</string>
    <string name="phone_need_health_update">请更新 Health Connect，数据来自那里。</string>
    <string name="phone_need_health_install">请安装 Health Connect，数据来自那里。</string>
    <string name="phone_need_health_none">这台手机没有 Health Connect。</string>
    <string name="phone_need_health_read">请允许 Kyllene 在 Health Connect 中读取步数、睡眠或心率。</string>
    <string name="phone_need_call_notifications">请开启 Kyllene 的通知：来电会在那里响铃。</string>
    <string name="phone_need_full_screen">请允许全屏通知，这样来电会显示在锁屏上方。</string>
    <string name="phone_need_android">手机工具需要在 Android 手机上的 Kyllene 中使用。</string>
    <string name="phone_optional_closed">Kyllene 关闭时也可用（可选）</string>
    <string name="phone_optional_health">也包括步数、睡眠或心率（可选）</string>

    <string name="phone_tool_battery">电池</string>
    <string name="phone_tool_battery_detail">电量、是否在充电以及充满所需时间。</string>
    <string name="phone_tool_network">网络</string>
    <string name="phone_tool_network_detail">Wi-Fi、移动数据或离线，是否按流量计费，以及 VPN。</string>
    <string name="phone_tool_sound">声音</string>
    <string name="phone_tool_sound_detail">勿扰模式、铃声模式和音量。更改前会先询问。</string>
    <string name="phone_tool_alarms">闹钟和计时器</string>
    <string name="phone_tool_alarms_detail">经你允许后，在时钟应用中设置一个。</string>
    <string name="phone_tool_screen_time">屏幕使用时间</string>
    <string name="phone_tool_screen_time_detail">你用了哪些应用、用了多久、亮屏时间和解锁次数，最多回溯一周。</string>
    <string name="phone_tool_open">打开链接、地图和应用</string>
    <string name="phone_tool_open_detail">经你允许后，打开链接、地点、应用或分享菜单。</string>
    <string name="phone_tool_clipboard">复制到剪贴板</string>
    <string name="phone_tool_clipboard_detail">经你允许后，把文本放到剪贴板。从不读取其中的内容。</string>
    <string name="phone_tool_location">位置</string>
    <string name="phone_tool_location_detail">手机所在位置和最近的地址，精度取决于你的授权。仅在 Kyllene 打开时，除非你也允许在关闭时使用。</string>
    <string name="phone_tool_geofences">监视的地点</string>
    <string name="phone_tool_geofences_detail">到达或离开某个地点时，会把它的消息发到添加它的对话中。添加或移除前会先询问；需要始终允许精确位置。</string>
    <string name="phone_tool_calendar">日历</string>
    <string name="phone_tool_calendar_detail">某个时间范围内的日程。添加或移动日程前会先询问。</string>
    <string name="phone_tool_contacts">联系人</string>
    <string name="phone_tool_contacts_detail">按姓名、号码或邮箱查找联系人：只读取姓名、号码和邮箱，每次少量。</string>
    <string name="phone_tool_health">健康</string>
    <string name="phone_tool_health_detail">来自 Health Connect 的步数、睡眠和心率，范围取决于你在那里的授权。仅在 Kyllene 打开时，除非你也允许在关闭时使用。</string>
    <string name="phone_tool_show_ui">对话中的界面（实验）</string>
    <string name="phone_tool_show_ui_detail">代理在回复下方绘制一个小界面，包含按钮、选项或表单，并最多等待你点按 5 分钟。仅限 Android。</string>
    <string name="phone_tool_call_me">Hermes 可以给我打电话</string>
    <string name="phone_tool_call_me_detail">当事情等不了，或你让它打给你时（包括来自定时任务），代理会给你打电话。接听后 Hermes 会在通话中告诉你原因。只会打给你。</string>
</resources>
