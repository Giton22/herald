<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A GPT-Live call switches the audio to call mode and the speaker. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- WebRTC watches the network for the call; without this it aborts as the call starts. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A voice chat goes on with the screen off, like a call (VoiceCallService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- With Notifications anywhere, pick the ntfy stream up again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The Sound phone tool: Do Not Disturb and the ringer, once the user grants Do Not Disturb access. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- The Alarms phone tool hands an alarm or a timer to the clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The Screen time phone tool, once the user grants Usage access in Android's settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- The Location phone tool, while Herald is open; the user picks precise or approximate. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only if the user also allows location while Herald is closed, from its own row under the Location switch. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- The Calendar phone tool: reads events, and adds or moves one after the user allows it. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- The Contacts phone tool looks people up by name, number or email; it never writes. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
        The Health phone tool reads these three from Health Connect, each as the user allows there; while Herald is
        closed too only if the user also allows that, from its own row under the Health switch.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!--
        Calls for an answer (Settings → Phone tools → Calls, off until turned on): an approval or a question rings over
        the lock screen. Android 14 and later grant it to calling apps only, so the user allows it from that row.
        Herald never places a phone call: it has no CALL_PHONE.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Location is one optional tool: a phone or tablet without GPS still installs Herald. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <!-- The assistant names the app it was called up over; apps are hidden from Herald unless it says which it looks up. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Dictation on the phone picks a speech recognizer other than Herald's own. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The Alarms phone tool checks there's a clock app before it asks the user. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- Screen time leaves out the home screen, as the phone's own does. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The Open phone tool checks there's a browser, a maps app or a share target before it asks the user. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The Health phone tool: Health Connect, an app of its own before Android 14. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!--
        Self-hosted gateways are commonly plain HTTP on a LAN or Tailnet, so cleartext is allowed;
        the Connect screen warns when http:// points at a public address (GatewayUrl.isExposed).
    -->
    <application
        android:name=".HermesApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HermesKotlin"
        android:usesCleartextTraffic="true">

        <!-- The app; the launcher opens it through the icon aliases below. -->
        <activity
            android:name=".HeraldActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!--
                hermes://new-chat and new-chat-voice start a chat; voice-chat starts a voice conversation;
                session/<id> opens a stored chat;
                bot/<profile> opens that bot's chat, the link Hermes Desktop uses for a bot.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hermes" />
                <data android:host="new-chat" />
                <data android:host="new-chat-voice" />
                <data android:host="voice-chat" />
                <data android:host="session" />
                <data android:host="bot" />
            </intent-filter>
            <!--
                The browser sign-in ends at <applicationId>:/signed-in (AndroidLoopbackReceiver): it closes the browser
                tab and brings Herald back. Named after the app ID, so Herald Dev doesn't catch Herald's.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
            <!--
                Text, links, pictures and files shared from other apps start a new chat with them as its draft.
                Any type: the composer attaches any file, within its size limits.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            The app icons (AppIcons, picked in Settings): one launcher entry each, exactly one enabled. The default's
            is named after the activity's old name, so a home-screen icon from before still points at it. Each
            carries the launcher shortcuts, which Android reads from the launcher entry.
        -->
        <activity-alias
            android:name=".MainActivity"
            android:exported="true"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violet"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconOrange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconPink"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pink"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconHearts"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hearts"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconMarks"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_marks"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconBubbles"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bubbles"
            android:targetActivity=".HeraldActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!--
            Health Connect's "privacy policy" link for Herald: the README's Privacy section, in the browser. Invisible.
            The alias is for Android 14 and later, the activity's own filter for Health Connect as an app before that.
        -->
        <activity
            android:name=".phone.HealthPrivacyActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".HealthPermissionsUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".phone.HealthPrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Wakes the app after a reboot or an update, so Notifications anywhere listens again. -->
        <receiver
            android:name=".notify.RestartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Keeps the gateway socket alive while a turn runs, and the process up with Notifications anywhere. -->
        <service
            android:name=".notify.ChatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a WebSocket to the user's self-hosted agent gateway open so running turns, approvals and replies reach the device." />
        </service>

        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!-- Android's proximity alert for a place the agent watches (the Watched places phone tool). -->
        <receiver
            android:name=".phone.GeofenceReceiver"
            android:exported="false" />

        <!--
            Messages from Herald's watch app (the Data Layer delivers only from an app with this package name and
            signing key): what's asked there goes to Hermes from here.
        -->
        <service
            android:name=".wear.WearBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/herald/"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".notify.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Herald as the phone's digital assistant: the assist gesture opens a panel over the current app. -->
        <service
            android:name=".assist.HeraldAssistService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".assist.HeraldAssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Shows the microphone prompt for the assistant panel, which can't; invisible and kept out of Herald's task. -->
        <activity
            android:name=".assist.MicrophonePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- A call for an answer, full screen over the lock screen; out of Herald's task, so Back leaves it. -->
        <activity
            android:name=".notify.IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.HermesKotlin" />

        <!-- A call for an answer, picked up: Hermes on the line, no chat behind it. Its own task, as a call is, and
             in Recents to come back to while it goes on. -->
        <activity
            android:name=".notify.PhoneCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="dev.herald.call"
            android:theme="@style/Theme.HermesKotlin" />

        <!-- Allow on a phone tool's question: does the change from the tap, invisible and out of Herald's task. -->
        <activity
            android:name=".phone.PhoneActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".phone.PhoneDenyReceiver"
            android:exported="false" />

        <service
            android:name=".assist.HeraldRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Lets the camera app write a photo for the composer into our cache (AttachmentPicker). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>
    </application>
</manifest>
