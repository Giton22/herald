<?xml version="1.0" encoding="utf-8"?>
<!-- A collection's loading row (docs/WIDGETS-DESIGN.md §7.2): the same shape as a row, inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_chats_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_content_padding_horizontal"
    android:paddingEnd="@dimen/widget_content_padding_horizontal">

    <ImageView
        android:layout_width="@dimen/widget_face_row"
        android:layout_height="@dimen/widget_face_row"
        android:background="@drawable/widget_well_background" android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_gap_related"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_surface2_background" android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="92dp"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_well_background" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
