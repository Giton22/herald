<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages Herald ships. Android 13 and later list exactly these in Settings › Apps › Herald › Language,
    and the phone's own language picks one of them on first start; Compose resources fall back to values/ (English)
    for any key a translation is still missing.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
</locale-config>
