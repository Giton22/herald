<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The home-screen widget (HomeWidget), in the app's light colors; values-night has the dark ones. -->
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_chip">#EEF0F4</color>
    <color name="widget_text">#15161A</color>

    <style name="HomeWidgetGateway">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_gateway</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="HomeWidgetAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_action</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
