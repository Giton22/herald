<?xml version="1.0" encoding="utf-8"?>
<!-- The summit in one color (ic_launcher_monochrome, its body cut off at y 82) cropped to fill the status bar's 24dp icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="56"
    android:viewportHeight="56">
    <group
        android:translateX="-26"
        android:translateY="-30">
        <group>
            <clip-path android:pathData="@string/launcher_summit_sun_clip" />
            <path android:fillColor="#FFFFFF" android:pathData="@string/launcher_summit_sun" />
        </group>
        <path android:fillColor="#FFFFFF" android:pathData="@string/launcher_summit_cap" />
        <path android:fillColor="#FFFFFF" android:pathData="@string/launcher_summit_badge_body" />
    </group>
</vector>
